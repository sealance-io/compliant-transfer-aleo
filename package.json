{
  "name": "compliant-transfer-aleo",
  "version": "0.0.1",
  "description": "Compliant transfer functionalities using the Aleo blockchain",
  "author": "Sealance Team",
  "license": "Apache-2.0",
  "private": "true",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint:lockfile": "node scripts/validate-lockfile.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build --workspace=@sealance-io/policy-engine-aleo && changeset publish",
    "lint:licenses": "npx license-checker-rseidelsohn --failOn 'GPL-2.0-only;GPL-2.0-or-later;GPL-3.0-only;GPL-3.0-or-later;AGPL-3.0-only;AGPL-3.0-or-later'",
    "deploy:devnode": "lionden recipe --file recipes/setup.ts --network devnode",
    "deploy:testnet": "lionden recipe --file recipes/setup.ts --network testnet",
    "compile": "lionden compile",
    "format": "prettier --check --config ./.prettierrc.yaml \"**/*.{js,cjs,mjs,json,md,sol,ts,cts,mts,yaml,yml}\"",
    "format:fix": "prettier --config ./.prettierrc.yaml --write \"**/*.{js,cjs,mjs,json,md,sol,ts,cts,mts,yaml,yml}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace=@sealance-io/policy-engine-aleo && lionden test",
    "test:devnet": "npm run build --workspace=@sealance-io/policy-engine-aleo && npm run compile -- --network testnet && for f in test/*.test.ts; do TEST_MODE=devnet npx lionden test \"$f\" --network devnet --no-compile --timeout 7200000 || exit 1; done"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@lionden/cli": "0.1.1",
    "@lionden/config": "0.1.1",
    "@lionden/core": "0.1.1",
    "@lionden/leo-compiler": "0.1.1",
    "@lionden/network": "0.1.1",
    "@lionden/plugin-deploy": "0.1.1",
    "@lionden/plugin-leo": "0.1.1",
    "@lionden/plugin-network": "0.1.1",
    "@lionden/plugin-test": "0.1.1",
    "@lionden/testing": "0.1.1",
    "@provablehq/sdk": "0.11.5",
    "@sealance-io/policy-engine-aleo": "workspace:*",
    "@types/node": "^24.12.4",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "testcontainers": "^12.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
