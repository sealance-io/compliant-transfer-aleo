{
  "name": "compliant-transfer-aleo",
  "version": "0.0.1",
  "description": "Compliant transfer functionalities using the Aleo blockchain",
  "author": "Sealance Team",
  "license": "Apache-2.0",
  "private": "true",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint:lockfile": "node scripts/validate-lockfile.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build --workspace=@sealance-io/policy-engine-aleo && changeset publish",
    "deploy:devnet": "lionden --config lionden.config.ts run scripts/deploy.ts --network devnode",
    "deploy:testnet": "lionden --config lionden.config.ts run scripts/deploy.ts --network testnet",
    "update-freeze-list:devnet": "npx tsx --tsconfig tsconfig.tsx.json scripts/update-freeze-list.ts",
    "update-freeze-list:testnet": "cross-env TESTNET_ENDPOINT='https://api.explorer.provable.com/v1' npx tsx --tsconfig tsconfig.tsx.json scripts/update-freeze-list.ts",
    "compile": "lionden --config lionden.config.ts compile ",
    "format": "prettier --check --config ./.prettierrc.yaml \"**/*.{js,cjs,mjs,json,md,sol,ts,cts,mts,yaml,yml}\"",
    "format:fix": "prettier --config ./.prettierrc.yaml --write \"**/*.{js,cjs,mjs,json,md,sol,ts,cts,mts,yaml,yml}\"",
    "test": "lionden --config lionden.config.ts test --no-compile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@lionden/cli": "file:../lionden/packages/cli",
    "@lionden/config": "file:../lionden/packages/config",
    "@lionden/core": "file:../lionden/packages/core",
    "@lionden/leo-compiler": "file:../lionden/packages/leo-compiler",
    "@lionden/network": "file:../lionden/packages/network",
    "@lionden/plugin-deploy": "file:../lionden/packages/plugin-deploy",
    "@lionden/plugin-leo": "file:../lionden/packages/plugin-leo",
    "@lionden/plugin-network": "file:../lionden/packages/plugin-network",
    "@lionden/plugin-test": "file:../lionden/packages/plugin-test",
    "@lionden/testing": "file:../lionden/packages/testing",
    "@provablehq/sdk": "0.10.5",
    "@sealance-io/policy-engine-aleo": "workspace:*",
    "@types/node": "^24.12.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "testcontainers": "^12.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
